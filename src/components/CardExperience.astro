---
  import { Image } from "astro:assets";
  const { image, name, jobposition, date, description1, description2, isLast } = Astro.props;
---

<div class="timeline-item group relative flex gap-5 sm:gap-7 pb-10 sm:pb-14">
  {!isLast && (
    <div class="absolute left-[7.5px] sm:left-[13px] top-6 bottom-0 w-px bg-gradient-to-b from-white/30 to-white/5" />
  )}

  <div class="relative z-10 flex-shrink-0 pt-3">
    <div class="w-4 h-4 sm:w-7 sm:h-7 rounded-full border-2 border-white/40 bg-[#1F2430] group-hover:border-white/70 transition-colors duration-300">
      <div class="w-full h-full rounded-full bg-white/20 group-hover:bg-white/40 transition-colors duration-300" />
    </div>
  </div>

  <div class="flex-1 relative">
    <div class="absolute top-[-10px] right-[-10px] w-full h-full bg-[#F5F5F5] rounded-2xl" />
    <div class="w-full p-5 sm:p-6 bg-[#1F2430] rounded-2xl relative border-2 border-white">
      <div class="flex items-center justify-around mb-4">
        <Image
          src={image}
          alt={name}
          class="w-20 sm:w-36 flex-shrink-0"
          loading="lazy"
        />
        <div class="text-center">
          <p class="text-base sm:text-lg font-medium">{name}</p>
          <p class="text-sm text-white/80">{jobposition}</p>
          <p class="text-xs text-white/50 mt-1">{date}</p>
        </div>
      </div>

      <div class="space-y-3 text-xs sm:text-sm text-white/70 leading-relaxed">
        <p>{description1}</p>
        <p>{description2}</p>
      </div>
    </div>
  </div>
</div>